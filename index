<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Approximate Home Weight Calculator</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    background: #f2f2f2;
    color: #111;
    padding: 28px;
  }
  .wrap { max-width: 1080px; margin: 0 auto; }
  .card {
    background: #fff;
    border: 2px solid #c8e6c9;
    border-radius: 14px;
    box-shadow: 0 10px 24px rgba(0,0,0,0.05);
    overflow: hidden;
  }
  .head {
    background: linear-gradient(180deg,#fbfefb,#f3fbf3);
    border-bottom: 1.5px solid #d8edd8;
    padding: 18px 22px;
  }
  .eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2e7d32;
    margin-bottom: 6px;
  }
  h1 { margin: 0; font-size: 28px; line-height: 1.1; }
  .sub {
    margin-top: 8px;
    color: #666;
    font-size: 14px;
    line-height: 1.55;
  }
  .body { padding: 22px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  label {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 6px;
  }
  select, input[type="number"] {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1.5px solid #c8e6c9;
    background: #f9fdf9;
    font-size: 14px;
    font-family: inherit;
  }
  select:focus, input:focus {
    outline: 2px solid #2e7d32;
    border-color: #2e7d32;
  }
  .range-wrap { margin-top: 18px; }
  input[type="range"] { width: 100%; accent-color: #2e7d32; }
  .years-text { margin-top: 6px; color: #666; font-size: 13px; }
  .results {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .chip {
    flex: 1;
    min-width: 180px;
    background: #f0faf0;
    border: 1.5px solid #c8e6c9;
    border-radius: 10px;
    padding: 12px 14px;
    text-align: center;
  }
  .chip.total {
    background: #e8f5e9;
    border-color: #2e7d32;
  }
  .chip .k {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2e7d32;
    margin-bottom: 4px;
  }
  .chip .v {
    font-size: 28px;
    font-weight: 900;
    font-family: Arial, sans-serif;
    line-height: 1;
  }
  .chip .u {
    font-size: 11px;
    color: #666;
    margin-top: 4px;
  }
  .section-title {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 2px solid #e6f3e6;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2e7d32;
  }
  .note, .disclaimer {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 10px;
    line-height: 1.6;
    font-size: 13px;
  }
  .note {
    background: #fff;
    border: 1.5px solid #d8edd8;
    color: #666;
  }
  .disclaimer {
    background: #fafafa;
    border: 1.5px solid #e6e6e6;
    color: #555;
  }
</style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="head">
        <div class="eyebrow">Estimator Tool</div>
        <h1>Approximate Home Weight Calculator</h1>
        <div class="sub">Standalone version with home weight, materials, suggested crew, packing time, and quote range.</div>
      </div>

      <div class="body">
        <div class="grid">
          <div>
            <label for="homeType">Home Type</label>
            <select id="homeType" onchange="toggleSqft(); updateCalc();">
              <option value="studio">Studio Apartment</option>
              <option value="1bed">1 Bed Apartment</option>
              <option value="2bed">2 Bed Apartment</option>
              <option value="3bed">3 Bed Apartment</option>
              <option value="house">House</option>
              <option value="condo">Condo</option>
            </select>
          </div>

          <div id="sqftWrap" style="display:none;">
            <label for="sqft">Square Footage</label>
            <input type="number" id="sqft" min="1250" max="5000" step="50" value="1250" oninput="updateCalc();">
          </div>

          <div>
            <label for="garage">Garage</label>
            <select id="garage" onchange="updateCalc();">
              <option value="0">None</option>
              <option value="1">1 Car</option>
              <option value="2">2 Car</option>
            </select>
          </div>

          <div>
            <label for="furnishing">Furnishing Level</label>
            <select id="furnishing" onchange="updateCalc();">
              <option value="1">Standard</option>
              <option value="0.85">Lightly Furnished (-15%)</option>
              <option value="1.25">Felt Like a Lot of Stuff (+25%)</option>
            </select>
          </div>

          <div>
            <label for="baseRate">Base Hourly Rate</label>
            <input type="number" id="baseRate" min="0" step="1" value="0" oninput="updateCalc();">
          </div>

          <div>
            <label for="packingMode">Packing Option</label>
            <select id="packingMode" onchange="updateCalc();">
              <option value="with">Include Packing</option>
              <option value="without">No Packing</option>
            </select>
          </div>

          <div>
            <label for="roundTripMiles">Round Trip Miles</label>
            <input type="number" id="roundTripMiles" min="0" step="1" value="0" oninput="updateCalc();">
          </div>
        </div>

        <div class="range-wrap">
          <label for="years">Years Lived There</label>
          <input type="range" id="years" min="0" max="40" step="1" value="0" oninput="updateYears(); updateCalc();">
          <div class="years-text"><span id="yearsLabel">0</span> years</div>
        </div>

        <div class="results">
          <div class="chip">
            <div class="k">Low Weight</div>
            <div class="v" id="lowWeight">1,500</div>
            <div class="u">lbs</div>
          </div>
          <div class="chip">
            <div class="k">High Weight</div>
            <div class="v" id="highWeight">1,500</div>
            <div class="u">lbs</div>
          </div>
          <div class="chip total">
            <div class="k">Pack Materials</div>
            <div class="v" id="materials">$300</div>
            <div class="u">baseline</div>
          </div>
        </div>

        <div class="section-title">Crew and Pricing</div>

        <div class="results">
          <div class="chip">
            <div class="k">Suggested Trucks</div>
            <div class="v" id="trucks">1</div>
            <div class="u">truck(s)</div>
          </div>
          <div class="chip">
            <div class="k">Suggested Crew</div>
            <div class="v" id="crew">2</div>
            <div class="u">guys</div>
          </div>
          <div class="chip">
            <div class="k">Man Hours</div>
            <div class="v" id="manHours">6.0</div>
            <div class="u">weight ÷ 250 ROM</div>
          </div>
          <div class="chip">
            <div class="k">Hourly Rate</div>
            <div class="v" id="rate">$150</div>
            <div class="u">$50 per truck and guy</div>
          </div>
          <div class="chip">
            <div class="k">Drive Hours</div>
            <div class="v" id="driveHours">1.0</div>
            <div class="u">1 hr min, +1 per 55 mi</div>
          </div>
          <div class="chip">
            <div class="k" id="packingMetricLabel">Packing Hours</div>
            <div class="v" id="packingHours">1.25</div>
            <div class="u" id="packingMetricUnit">1 hr per $250 materials</div>
          </div>
        </div>

        <div class="results">
          <div class="chip">
            <div class="k">Low Quote</div>
            <div class="v" id="lowQuote">$239</div>
            <div class="u">-20%</div>
          </div>
          <div class="chip total">
            <div class="k">Baseline Quote</div>
            <div class="v" id="midQuote">$299</div>
            <div class="u" id="quoteBasisLabel">packing based</div>
          </div>
          <div class="chip">
            <div class="k">High Quote</div>
            <div class="v" id="highQuote">$359</div>
            <div class="u">+20%</div>
          </div>
        </div>

        <div class="note">
          Crew logic used here:
          1 truck holds 8,000 lbs and up to 5 guys.
          Average ROM is set to 250 lbs per man hour.
          Man hours = average weight ÷ 250.
          Job hours = man hours ÷ crew size.
          The calculator picks an optimal crew to target roughly 4 hours for smaller moves and 8-10 hours for larger moves while staying within truck capacity.
          Hourly rate = $50 for each truck + $50 for each crew member. Base rate starts at $0.
          If packing is included: packing time = 1 hour for every $250 in materials. If packing is not included: add $125 in materials for every 3,000 lbs. Drive time adds 1 hour per 55 round-trip miles, rounded up to the nearest half hour, with a 1 hour minimum. Quote range = baseline amount with a -20% and +20% range.
        </div>

        <div class="disclaimer">
          <strong>Disclaimer:</strong> This is not something to base all estimates off of. This is to give you a baseline weight, if your weight/materials are similar than you are good. If you think you are off and its nowhere near what the calculator populates then it probably off.
        </div>
      </div>
    </div>
  </div>

<script>
function fmt(n) {
  return Math.round(n).toLocaleString();
}
function money(n) {
  return "$" + Math.round(n).toLocaleString();
}
function roundQuarterUp(n) {
  return Math.ceil((n || 0) * 4) / 4;
}
function roundHalfUp(n) {
  return Math.ceil((n || 0) * 2) / 2;
}
function updateYears() {
  document.getElementById("yearsLabel").textContent = document.getElementById("years").value;
}
function toggleSqft() {
  const type = document.getElementById("homeType").value;
  document.getElementById("sqftWrap").style.display = type === "house" ? "block" : "none";
}
function suggestCrewAndTrucks(avgWeight) {
  const ROM = 250;
  const manHours = avgWeight / ROM;
  const trucks = Math.max(1, Math.ceil(avgWeight / 8000));
  const maxCrew = trucks * 5;

  let targetHours = avgWeight <= 5000 ? 4 : 9;

  let bestCrew = 2;
  let bestDiff = Infinity;
  let bestHours = manHours / bestCrew;

  for (let crew = 2; crew <= maxCrew; crew++) {
    const hours = manHours / crew;
    let diff = Math.abs(hours - targetHours);

    if (avgWeight > 5000) {
      if (hours < 8) diff += 0.75;
      if (hours > 10) diff += 1.25;
    } else {
      if (hours > 5) diff += 1.0;
      if (hours < 3) diff += 0.5;
    }

    if (diff < bestDiff) {
      bestDiff = diff;
      bestCrew = crew;
      bestHours = hours;
    }
  }

  return { trucks, crew: bestCrew, manHours, laborHours: bestHours };
}

function updateCalc() {

  const type = document.getElementById("homeType").value;
  const garage = parseInt(document.getElementById("garage").value, 10);
  const years = parseInt(document.getElementById("years").value, 10);
  const furnishing = parseFloat(document.getElementById("furnishing").value);
  const baseRate = parseFloat(document.getElementById("baseRate").value || "0");

  let low = 1500, high = 1500, materials = 300;

  if (type === "studio" || type === "condo") {
    low = 1500; high = 1500; materials = 300;
  } else if (type === "1bed") {
    low = 3000; high = 3000; materials = 450;
  } else if (type === "2bed") {
    low = 4500; high = 4500; materials = 600;
  } else if (type === "3bed") {
    low = 6000; high = 6000; materials = 750;
  } else if (type === "house") {
    const sqft = Math.max(1250, Math.min(5000, parseInt(document.getElementById("sqft").value || "1250", 10)));
    const steps = Math.floor((sqft - 1250) / 250);
    low = 5000 + (steps * 1000);
    high = low + 1000;
    materials = 750 + (steps * 100);
  }

  if (garage === 1) {
    low += 750; high += 750; materials += 100;
  } else if (garage === 2) {
    low += 1250; high += 1250; materials += 200;
  }

  let multiplier = 1 + (Math.floor(years / 3) * 0.05);
  multiplier *= furnishing;

  low = Math.round(low * multiplier);
  high = Math.round(high * multiplier);
  materials = Math.round(materials * multiplier);

  const avgWeight = Math.round((low + high) / 2);
  const setup = suggestCrewAndTrucks(avgWeight);
  const ROM = 250;
  const manHours = avgWeight / ROM;
  const laborHours = roundQuarterUp(manHours / setup.crew);
  const rate = (setup.trucks * 50) + (setup.crew * 50);
  const packingMode = document.getElementById("packingMode").value;
  const roundTripMiles = parseFloat(document.getElementById("roundTripMiles").value || "0");

  let packingMetric = 0;
  let baselineQuote = 0;
  const driveHours = Math.max(1, roundHalfUp(roundTripMiles / 55));
  let totalLaborHours = laborHours + driveHours;

  if (packingMode === "with") {
    packingMetric = roundQuarterUp(materials / 250);
    totalLaborHours = laborHours + packingMetric + driveHours;
    baselineQuote = rate * totalLaborHours;
    document.getElementById("packingMetricLabel").textContent = "Packing Hours";
    document.getElementById("packingMetricUnit").textContent = "1 hr per $250 materials";
    document.getElementById("quoteBasisLabel").textContent = "labor + packing + drive";
  } else {
    packingMetric = Math.round((avgWeight / 3000) * 125);
    baselineQuote = (rate * totalLaborHours) + packingMetric;
    document.getElementById("packingMetricLabel").textContent = "Material Add";
    document.getElementById("packingMetricUnit").textContent = "$125 per 3,000 lbs";
    document.getElementById("quoteBasisLabel").textContent = "labor + drive + material add";
  }

  const lowQuote = baselineQuote * 0.80;
  const highQuote = baselineQuote * 1.20;

  document.getElementById("lowWeight").textContent = fmt(low);
  document.getElementById("highWeight").textContent = fmt(high);
  document.getElementById("materials").textContent = money(materials);

  document.getElementById("trucks").textContent = setup.trucks;
  document.getElementById("crew").textContent = setup.crew;
  document.getElementById("manHours").textContent = manHours.toFixed(1);
  document.getElementById("rate").textContent = money(rate);
  document.getElementById("driveHours").textContent = driveHours.toFixed(1);
  document.getElementById("packingHours").textContent = packingMode === "with" ? packingMetric.toFixed(2) : money(packingMetric);

  document.getElementById("lowQuote").textContent = money(lowQuote);
  document.getElementById("midQuote").textContent = money(baselineQuote);
  document.getElementById("highQuote").textContent = money(highQuote);
}

toggleSqft();
updateYears();
updateCalc();
</script>
</body>
</html>
