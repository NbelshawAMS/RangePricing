<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Home Weight + Crew + Pricing Calculator</title>

<style>
* { box-sizing: border-box; }
body {
  margin:0;
  font-family: Georgia, "Times New Roman", serif;
  background:#f2f2f2;
  padding:28px;
}
.wrap { max-width:1100px; margin:auto; }
.card {
  background:#fff;
  border:2px solid #c8e6c9;
  border-radius:14px;
  box-shadow:0 10px 24px rgba(0,0,0,0.05);
}
.head {
  padding:18px 22px;
  border-bottom:1px solid #e6f3e6;
}
h1 { margin:0; font-size:26px; }
.body { padding:22px; }

.grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:14px;
}

label {
  font-size:10px;
  font-weight:800;
  text-transform:uppercase;
  margin-bottom:6px;
  display:block;
}

select,input {
  width:100%;
  padding:10px;
  border-radius:8px;
  border:1px solid #c8e6c9;
}

.results {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:18px;
}

.chip {
  flex:1;
  min-width:180px;
  background:#f0faf0;
  border:1px solid #c8e6c9;
  border-radius:10px;
  padding:12px;
  text-align:center;
}

.k {
  font-size:10px;
  font-weight:800;
  text-transform:uppercase;
  color:#2e7d32;
}
.v {
  font-size:26px;
  font-weight:900;
}
.u {
  font-size:11px;
  color:#666;
}

.section-title {
  margin-top:28px;
  font-weight:800;
  font-size:11px;
  text-transform:uppercase;
  color:#2e7d32;
}

.disclaimer {
  margin-top:18px;
  font-size:13px;
  color:#555;
}
</style>
</head>

<body>
<div class="wrap">
<div class="card">

<div class="head">
<h1>Home Weight + Crew + Pricing Calculator</h1>
</div>

<div class="body">

<div class="grid">

<div>
<label>Home Type</label>
<select id="type" onchange="calc()">
<option value="studio">Studio</option>
<option value="1bed">1 Bed</option>
<option value="2bed">2 Bed</option>
<option value="3bed">3 Bed</option>
<option value="house">House</option>
</select>
</div>

<div id="sqftWrap" style="display:none;">
<label>Sqft</label>
<input type="number" id="sqft" value="1250" oninput="calc()">
</div>

<div>
<label>Garage</label>
<select id="garage" onchange="calc()">
<option value="0">None</option>
<option value="1">1 Car</option>
<option value="2">2 Car</option>
</select>
</div>

<div>
<label>Furnishing</label>
<select id="furnish" onchange="calc()">
<option value="1">Standard</option>
<option value="0.85">Light (-15%)</option>
<option value="1.25">Heavy (+25%)</option>
</select>
</div>

<div>
<label>Packing</label>
<select id="packing" onchange="calc()">
<option value="with">With Packing</option>
<option value="without">No Packing</option>
</select>
</div>

<div>
<label>Round Trip Miles</label>
<input type="number" id="miles" value="0" oninput="calc()">
</div>

</div>

<!-- RESULTS -->

<div class="results">
<div class="chip"><div class="k">Weight</div><div class="v" id="weight">1500</div><div class="u">lbs</div></div>
<div class="chip"><div class="k">Materials</div><div class="v" id="materials">$300</div></div>
</div>

<div class="section-title">Crew Logic (ROM 250)</div>

<div class="results">
<div class="chip"><div class="k">Trucks</div><div class="v" id="trucks">1</div></div>
<div class="chip"><div class="k">Crew</div><div class="v" id="crew">2</div></div>
<div class="chip"><div class="k">Man Hours</div><div class="v" id="man">6</div></div>
<div class="chip"><div class="k">Labor Hours</div><div class="v" id="labor">3</div></div>
</div>

<div class="section-title">Time + Pricing</div>

<div class="results">
<div class="chip"><div class="k">Drive Hours</div><div class="v" id="drive">1</div></div>
<div class="chip"><div class="k">Packing</div><div class="v" id="pack">2</div></div>
<div class="chip"><div class="k">Rate</div><div class="v" id="rate">$200</div></div>
</div>

<div class="results">
<div class="chip"><div class="k">Low</div><div class="v" id="low">$200</div></div>
<div class="chip"><div class="k">Baseline</div><div class="v" id="mid">$300</div></div>
<div class="chip"><div class="k">High</div><div class="v" id="high">$400</div></div>
</div>

<div class="disclaimer">
This is a baseline tool — not final estimate.
</div>

</div>
</div>
</div>

<script>

function rQuarter(n){return Math.ceil(n*4)/4}
function rHalf(n){return Math.ceil(n*2)/2}

function calc(){

let type=document.getElementById("type").value
let sqft=document.getElementById("sqft").value||1250
let garage=parseInt(document.getElementById("garage").value)
let furnish=parseFloat(document.getElementById("furnish").value)
let packing=document.getElementById("packing").value
let miles=parseFloat(document.getElementById("miles").value||0)

document.getElementById("sqftWrap").style.display = type==="house"?"block":"none"

let weight=1500, materials=300

if(type==="1bed"){weight=3000;materials=450}
if(type==="2bed"){weight=4500;materials=600}
if(type==="3bed"){weight=6000;materials=750}
if(type==="house"){
let steps=Math.floor((sqft-1250)/250)
weight=5000+(steps*1000)
materials=750+(steps*100)
}

if(garage===1){weight+=750;materials+=100}
if(garage===2){weight+=1250;materials+=200}

weight*=furnish
materials*=furnish

// ROM LOGIC
let manHours = weight / 250

// trucks
let trucks = Math.ceil(weight/8000)||1
let maxCrew = trucks*5

// optimal crew
let target = weight<=5000?4:9
let bestCrew=2
let bestDiff=999

for(let c=2;c<=maxCrew;c++){
let hrs=manHours/c
let diff=Math.abs(hrs-target)
if(diff<bestDiff){bestDiff=diff;bestCrew=c}
}

let laborHours=rQuarter(manHours/bestCrew)

// drive
let drive=Math.max(1,rHalf(miles/55))

// packing
let pack=0
let baseline=0

let rate=(trucks*50)+(bestCrew*50)

if(packing==="with"){
pack=rQuarter(materials/250)
baseline=rate*(laborHours+pack+drive)
}else{
pack=Math.round((weight/3000)*125)
baseline=(rate*(laborHours+drive))+pack
}

// range
let low=baseline*0.8
let high=baseline*1.2

// OUTPUT
document.getElementById("weight").innerText=Math.round(weight)
document.getElementById("materials").innerText="$"+Math.round(materials)

document.getElementById("trucks").innerText=trucks
document.getElementById("crew").innerText=bestCrew
document.getElementById("man").innerText=manHours.toFixed(1)
document.getElementById("labor").innerText=laborHours.toFixed(2)

document.getElementById("drive").innerText=drive.toFixed(1)
document.getElementById("pack").innerText=(packing==="with"?pack.toFixed(2):"$"+pack)

document.getElementById("rate").innerText="$"+rate

document.getElementById("mid").innerText="$"+Math.round(baseline)
document.getElementById("low").innerText="$"+Math.round(low)
document.getElementById("high").innerText="$"+Math.round(high)

}

calc()

</script>
</body>
</html>
